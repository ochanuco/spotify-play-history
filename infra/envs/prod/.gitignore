# Terraform working directory and state files
.terraform/
*.tfstate
*.tfstate.*

# Terraform plans and crash logs
*.tfplan
plan.out
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local-only variable files (often include secrets)
*.tfvars
*.tfvars.json

# Terraform CLI local config
.terraformrc
terraform.rc

# Local temp artifacts
.tmp/
*.zip
.DS_Store
